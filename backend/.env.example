# Chép thành backend/.env (Windows: copy .env.example .env). KHÔNG commit .env.
DATABASE_URL=postgresql+asyncpg://examind:examind@localhost:5432/examind
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=examind

# Mặc định để trống: frontend gọi qua rewrites /api/* của Next.js nên cùng origin, không cần CORS.
# Chỉ đặt http://localhost:3000 khi chạy frontend dev không qua rewrites. Nhiều origin phân tách bằng dấu phẩy.
CORS_ORIGINS=

# Phiên đăng nhập (issue #8)
COOKIE_NAME=examind_session
# false khi chạy HTTP (local). true khi trình duyệt tới qua HTTPS (prod).
COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# Admin mặc định: db-init chạy `python -m app.cli.ensure_admin` sau migration và tạo admin này nếu chưa có.
# Đã có thì không đổi gì (không ghi đè mật khẩu). Thiếu ADMIN_EMAIL hoặc ADMIN_PASSWORD thì bỏ qua.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Quản trị
# Tự đặt trong .env, không commit; prod cần ≥ 12 ký tự.
ADMIN_PASSWORD=

# Điền gmail để bật dịch vụ email và cấp thông tin OAuth có scope gmail.send.
EMAIL_PROVIDER=
EMAIL_FROM=examind.app@gmail.com
EMAIL_FROM_NAME=Examind
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Sinh chuỗi ngẫu nhiên riêng để băm OTP: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_OTP_SECRET=
# OAuth client cho đăng nhập. Đăng ký URL callback chính xác trong Google Auth Platform.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
