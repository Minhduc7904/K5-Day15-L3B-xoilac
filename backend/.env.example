# Chép thành backend/.env (Windows: copy .env.example .env). KHÔNG commit .env.
DATABASE_URL=postgresql+asyncpg://examind:examind@localhost:5432/examind
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=examind

# CORS chỉ cần khi frontend gọi thẳng backend khác origin (dev). Qua rewrites của Next.js thì để trống.
# Nhiều origin phân tách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:3000

# Phiên đăng nhập (issue #8)
COOKIE_NAME=examind_session
# false khi chạy HTTP (local). true khi trình duyệt tới qua HTTPS (prod).
COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# Issue #3. Điền khóa trên máy local để bật nhập PDF.
# MISTRAL_API_KEY=
# OPENAI_API_KEY=
OCR_MODEL=mistral-ocr-4-1
PDF_IMPORT_EXTRACTION_MODEL=gpt-5.4-mini
PDF_IMPORT_EMBEDDING_MODEL=text-embedding-3-small
